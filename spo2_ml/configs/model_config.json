{
  "model_type": "XGBClassifier",
  "objective": "binary:logistic",
  "eval_metric": "logloss",
  "random_state": 42,
  "early_stopping_rounds": 10,
  "default_params": {
    "n_estimators": 150,
    "max_depth": 4,
    "learning_rate": 0.05,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "min_child_weight": 3,
    "gamma": 0.1,
    "reg_alpha": 0.05,
    "reg_lambda": 1.0
  }
}
